#!/bin/bash -l
#PBS -N atode_obs_sweep
#PBS -A YOUR_ALLOCATION
#PBS -q prod
#PBS -l select=1
#PBS -l walltime=06:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

# Polaris lets you choose these at submission time, e.g.
#   qsub -l select=2 -v NRANKS=8,DATASETS="spring charged motion" scripts/polaris_obs_sweep.pbs
NODES="${PBS_NNODES:-1}"
NRANKS="${NRANKS:-4}"
RANKS_PER_NODE="${RANKS_PER_NODE:-$NRANKS}"
OMP_THREADS="${OMP_NUM_THREADS:-16}"

export OMP_NUM_THREADS
export MPICH_GPU_SUPPORT_ENABLED="${MPICH_GPU_SUPPORT_ENABLED:-0}"

module use /soft/modulefiles
module load conda

conda activate "${CONDA_ENV_NAME:-base}"

# These prepare the job environment for W&B, but AT_ODE/run_models.py must
# still call wandb.init(...) for actual online logging to happen.
export WANDB_PROJECT="${WANDB_PROJECT:-at_ode_polaris}"
export WANDB_ENTITY="${WANDB_ENTITY:-}"
export WANDB_MODE="${WANDB_MODE:-online}"
if [[ "${WANDB_MODE}" == "online" && -z "${WANDB_API_KEY:-}" ]]; then
  echo "WANDB_API_KEY is required when WANDB_MODE=online." >&2
  exit 2
fi

echo "PBS_O_WORKDIR=${PBS_O_WORKDIR}"
echo "NODES=$NODES NRANKS=$NRANKS RANKS_PER_NODE=$RANKS_PER_NODE OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "WANDB_PROJECT=$WANDB_PROJECT WANDB_MODE=$WANDB_MODE"

mpiexec -n "${NRANKS}" --ppn "${RANKS_PER_NODE}" \
  "${PBS_O_WORKDIR}/scripts/run_obs_sweep.sh"
